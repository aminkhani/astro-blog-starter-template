---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & { readingTime?: string };

const { title, description, pubDate, updatedDate, heroImage, tags, readingTime } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="post-header">
					<a class="back-link" href="/blog">&larr; All posts</a>
					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((t) => <span class="tag">{t}</span>)}
						</div>
					)}
					<h1>{title}</h1>
					<div class="meta-row">
						<FormattedDate date={pubDate} />
						{readingTime && (
							<>
								<span class="dot">&middot;</span>
								<span>{readingTime}</span>
							</>
						)}
						{updatedDate && (
							<>
								<span class="dot">&middot;</span>
								<span>Updated <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</div>
				</div>
				{heroImage && (
					<div class="hero-image">
						<img width={1200} height={600} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding: 3em 0 4em 0;
	}
	article {
		max-width: var(--container-prose);
		margin: 0 auto;
	}
	.post-header {
		margin-bottom: 2em;
	}
	.back-link {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.85em;
		color: var(--muted);
		text-decoration: none;
		margin-bottom: 1.4em;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.tags {
		display: flex;
		gap: 0.5em;
		margin-bottom: 0.8em;
	}
	.post-header h1 {
		margin-bottom: 0.4em;
	}
	.hero-image {
		margin: 2em 0;
	}
	.hero-image img {
		width: 100%;
		display: block;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
	}
</style>
