---
import type { HTMLAttributes } from 'astro/types';
import { stripLocale } from '../i18n/utils';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const rawPathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const pathname = stripLocale(rawPathname);
const hrefNormalized = stripLocale(String(href ?? ''));
const subpath = pathname.match(/[^\/]+/g);
const isActive = hrefNormalized === pathname || hrefNormalized === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
		position: relative;
		padding: 0.4em 0;
	}
	a.active {
		color: var(--ink);
		font-weight: 600;
	}
	a.active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.15em;
		height: 2px;
		background: var(--accent);
		border-radius: 2px;
	}
</style>
