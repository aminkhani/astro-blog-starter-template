---
import { SITE_TITLE } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const today = new Date();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer>
	<div class="footer-inner">
		<div class="footer-left">
			<span class="footer-brand">{SITE_TITLE}</span>
			<span class="footer-copy">&copy; {today.getFullYear()} &middot; {t('footer.built')}</span>
		</div>
		<div class="social-links">
			<a href="https://linkedin.com/in/aminkhanidev" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Connect on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.174-.432.57-.878 1.235-.878.87 0 1.219.662 1.219 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
					></path></svg
				>
			</a>
			<a href="https://github.com/aminkhani" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Go to Amin's GitHub profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="mailto:aminkhani.dev@gmail.com">
				<span class="sr-only">Email Amin</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"
					></path></svg
				>
			</a>
			<a href="/rss.xml">
				<span class="sr-only">RSS feed</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M2 2a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1c5.523 0 10 4.477 10 10a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1C15 6.716 9.284 1 2 1H2Zm0 5a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1c2.21 0 4 1.79 4 4a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1c0-3.314-2.686-6-6-6H2ZM2.5 12a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
					></path></svg
				>
			</a>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2.5em 1.25em;
		color: var(--muted);
	}
	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		flex-wrap: wrap;
	}
	.footer-left {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
	}
	.footer-brand {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--ink);
	}
	.footer-copy {
		font-family: var(--font-mono);
		font-size: 0.8em;
	}
	.social-links {
		display: flex;
		gap: 1em;
	}
	.social-links a {
		color: var(--muted);
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
