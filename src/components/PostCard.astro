---
import FormattedDate from './FormattedDate.astro';

interface Props {
	href: string;
	title: string;
	description: string;
	pubDate: Date;
	heroImage?: string;
	readingTime: string;
	tags?: string[];
	featured?: boolean;
}
const { href, title, description, pubDate, heroImage, readingTime, tags, featured } = Astro.props;
---

<a class:list={['card post-card', { featured }]} href={href}>
	{
		heroImage && (
			<div class="post-image">
				<img src={heroImage} alt="" width={720} height={360} />
			</div>
		)
	}
	<div class="post-body">
		{tags && tags.length > 0 && <span class="tag">{tags[0]}</span>}
		<h3 class="post-title">{title}</h3>
		<p class="post-desc">{description}</p>
		<div class="meta-row">
			<FormattedDate date={pubDate} />
			<span class="dot">&middot;</span>
			<span>{readingTime}</span>
		</div>
	</div>
</a>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}
	.post-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}
	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		display: block;
		transition: transform 0.3s ease;
	}
	.post-card:hover .post-image img {
		transform: scale(1.04);
	}
	.post-body {
		padding: 1.5em;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.post-title {
		margin: 0.5em 0 0.4em 0;
		font-size: 1.2em;
		color: var(--ink);
	}
	.post-card.featured .post-title {
		font-size: 1.5em;
	}
	.post-desc {
		color: var(--muted);
		font-size: 0.95em;
		margin-bottom: 1em;
		flex-grow: 1;
	}
	.post-card:hover .post-title {
		color: var(--accent);
	}
</style>
