---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
import { getLangFromUrl, useTranslations, getLangSwitchPath, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath(lang, '/');
---

<header>
	<nav>
		<a href={home} class="brand">
			<span class="brand-mark">&gt;_</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href={home}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={localizePath(lang, '/blog')}>{t('nav.blog')}</HeaderLink>
			<HeaderLink href={localizePath(lang, '/projects')}>{t('nav.projects')}</HeaderLink>
			<HeaderLink href={localizePath(lang, '/about')}>{t('nav.about')}</HeaderLink>
		</div>
		<div class="right-group">
			<div class="lang-switch">
				<a
					href={getLangSwitchPath(Astro.url, 'en')}
					class:list={[{ active: lang === 'en' }]}
					hreflang="en"
					lang="en"
				>
					EN
				</a>
				<span class="lang-sep" aria-hidden="true">/</span>
				<a
					href={getLangSwitchPath(Astro.url, 'fa')}
					class:list={[{ active: lang === 'fa' }]}
					hreflang="fa"
					lang="fa"
				>
					فا
				</a>
			</div>
			<div class="social-links">
				<a href="https://linkedin.com/in/aminkhanidev" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Connect on LinkedIn</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
						><path
							fill="currentColor"
							d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.174-.432.57-.878 1.235-.878.87 0 1.219.662 1.219 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
						></path></svg
					>
				</a>
				<a href="https://github.com/aminkhani" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Go to Amin's GitHub profile</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
				<a href="mailto:aminkhani.dev@gmail.com">
					<span class="sr-only">Email Amin</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
						><path
							fill="currentColor"
							d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"
						></path></svg
					>
				</a>
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		margin: 0;
		padding: 0 1.25em;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5em;
		max-width: 1200px;
		margin: 0 auto;
		height: 4em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05em;
		color: var(--ink);
	}
	.brand-mark {
		font-family: var(--font-mono);
		color: var(--accent);
		font-weight: 500;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.75em;
		font-size: 0.95em;
	}
	.internal-links a {
		color: var(--muted);
	}
	.internal-links a:hover {
		color: var(--ink);
	}
	.right-group {
		display: flex;
		align-items: center;
		gap: 1em;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.9em;
	}
	.social-links a {
		display: flex;
		color: var(--muted);
	}
	.social-links a:hover {
		color: var(--accent);
	}
	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.4em;
		font-family: var(--font-mono);
		font-size: 0.8em;
		font-weight: 600;
	}
	.lang-switch a {
		color: var(--muted);
		text-decoration: none;
		direction: ltr;
	}
	.lang-switch a.active {
		color: var(--accent);
	}
	.lang-switch a:hover {
		color: var(--ink);
	}
	.lang-sep {
		color: var(--border-strong);
	}
	@media (max-width: 640px) {
		.social-links {
			display: none;
		}
		.internal-links {
			gap: 1.1em;
			font-size: 0.9em;
		}
		.brand-name {
			display: none;
		}
	}
</style>
